// ===== Problem 2: Sorting Stones (5/6 worlds matched at last run) =====
function problem_2() {
function turnRight(k) {
  k.turnLeft();
  k.turnLeft();
  k.turnLeft();
}

function turnAround(k) {
  k.turnLeft();
  k.turnLeft();
}

function turnEast(k) {
  while (k.facingEast() == false) {
    k.turnLeft();
  }
}

function turnWest(k) {
  while (k.facingWest() == false) {
    k.turnLeft();
  }
}

function turnNorth(k) {
  while (k.facingNorth() == false) {
    k.turnLeft();
  }
}

function turnSouth(k) {
  while (k.facingSouth() == false) {
    k.turnLeft();
  }
}

function nextColumn(k) {
  turnRight(k);
  k.move();
  k.move();
  k.turnLeft();
}

function stackStones(k, stoneCount) {
  turnNorth(k);
  k.move();
  
  while (k.beepersPresent()) {
    k.move();
  }
  
  for (let i = 0; i < stoneCount; i++) {
    k.putBeeper();
    k.move();
  }
  
  turnSouth(k);
  while (k.frontIsClear()) {
    k.move();
  }
  turnNorth(k);
}

function main(k) {
  let redStone = 0;
  let greenStone = 0;
  let blueStone = 0;

  k.move();

  let checkingRows = true;
  while (checkingRows == true) {
    while (k.beepersPresent()) {
      if (k.cornerColorIs("Red")) {
        redStone++;
        k.pickBeeper();
      } else if (k.cornerColorIs("Green")) {
        greenStone++;
        k.pickBeeper();
      } else if (k.cornerColorIs("Blue")) {
        blueStone++;
        k.pickBeeper();
      }
    }

    if (k.frontIsClear() == false) {
      checkingRows = false;
    } else {
      k.move();
    }
  }

  turnSouth(k);
  while (k.frontIsClear()) {
    k.move();
  }

  turnEast(k);
  k.move();
  k.move();

  stackStones(k, redStone);
  
  nextColumn(k);
  stackStones(k, greenStone);
  
  nextColumn(k);
  stackStones(k, blueStone);
}
  return main;
}
